{
  "name": "gemfolders",
  "displayName": "Gemini Folders, Bookmarks & Search - Gemfolders: Chat Organizer",
  "version": "1.0.0",
  "description": "A browser extension to organize your Gemini chats",
  "author": "Emirhan Keskin",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "@supabase/supabase-js": "^2.93.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-arborist": "^3.4.3",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3.4.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.0.258",
    "@types/jest": "^30.0.0",
    "@types/node": "20.11.5",
    "@types/puppeteer": "^7.0.4",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@types/uuid": "^9.0.8",
    "crypto-browserify": "^3.12.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "puppeteer": "^24.36.1",
    "supabase": "^2.72.9",
    "ts-jest": "^29.4.6",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://gemini.google.com/*",
      "https://jqiqlsdtubcacdfyxbqz.supabase.co/*"
    ],
    "oauth2": {
      "client_id": "408933441627-l33jd7askcnii7jtv2gn2eifc9pocdm2.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ]
    },
    "permissions": [
      "storage",
      "identity"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "options.html"
        ],
        "matches": [
          "<all_urls>"
        ],
        "extension_ids": [
          "$CRX_ID"
        ]
      }
    ],
    "externally_connectable": {
      "matches": [
        "https://gemfolders.com/*"
      ]
    }
  }
}
